POSTGRES_DB=saathi_loans
POSTGRES_USER=saathi
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Use the same URL-encoded password as POSTGRES_PASSWORD and the Compose service name "db".
DATABASE_URL=postgresql://saathi:replace-with-a-long-random-database-password@db:5999/saathi_loans

# Generate independently. JWT_SECRET should be at least 32 random characters.
JWT_SECRET=replace-with-at-least-32-random-characters
# Exactly 64 hexadecimal characters (32 bytes).
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
SETUP_TOKEN=replace-with-a-long-one-time-random-token

# Public HTTPS origin with no trailing slash.
WEB_ORIGIN=https://loans.example.com
# Local-only port used by the host HTTPS reverse proxy.
HTTP_PORT=7001

# Never enable seed records in a real production deployment.
SEED_ON_START=false
SEED_PASSWORD=
